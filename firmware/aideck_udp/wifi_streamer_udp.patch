diff --git a/examples/other/wifi-img-streamer/gray4.c b/examples/other/wifi-img-streamer/gray4.c
new file mode 100644
index 0000000..3c0e118
--- /dev/null
+++ b/examples/other/wifi-img-streamer/gray4.c
@@ -0,0 +1,36 @@
+#include "gray4.h"
+
+uint32_t gray4_packed_size(uint16_t width, uint16_t height)
+{
+  return ((uint32_t)width * height + 1) / 2;
+}
+
+void gray4_build_index_map(uint16_t *map, uint16_t outputSize,
+                           uint16_t inputSize)
+{
+  for (uint16_t i = 0; i < outputSize; i++)
+  {
+    map[i] = ((uint32_t)i * inputSize) / outputSize;
+  }
+}
+
+void gray4_resize_pack(const uint8_t *source, uint16_t sourceWidth,
+                       const uint16_t *xMap, const uint16_t *yMap,
+                       uint16_t outputWidth, uint16_t outputHeight,
+                       uint8_t *output)
+{
+  uint32_t outputOffset = 0;
+  for (uint16_t y = 0; y < outputHeight; y++)
+  {
+    const uint8_t *row = source + (uint32_t)yMap[y] * sourceWidth;
+    for (uint16_t x = 0; x < outputWidth; x += 2)
+    {
+      uint8_t packed = (row[xMap[x]] >> 4) << 4;
+      if (x + 1 < outputWidth)
+      {
+        packed |= row[xMap[x + 1]] >> 4;
+      }
+      output[outputOffset++] = packed;
+    }
+  }
+}
